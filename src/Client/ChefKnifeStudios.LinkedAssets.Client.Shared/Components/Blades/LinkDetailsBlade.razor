@using ChefKnifeStudios.LinkedAssets.Client.Shared.Components.Map
@using ChefKnifeStudios.LinkedAssets.Client.Shared.Constants
@implements IAsyncDisposable
@inject IJSRuntime JS
<BladeContainer Title="@(LinkTypeTokens.Label(Link.Type)+" link")" Close="Close">
    <span class="sr-only" role="status">Selected @Link.Key: @string.Join(", ",Link.Members.Select(m=>m.Label))</span>
    <h3>Recent positions</h3>
    <RecentPositionsMap Statuses="Statuses.Values.ToArray()" Members="Link.Members.ToArray()" Dark="Dark" SelectionGeneration="Generation" />
    <h3>Latest reports</h3>
    <ul class="member-reports">
        @foreach(var member in Link.Members.OrderBy(m=>m.SourceName,StringComparer.Ordinal).ThenBy(m=>m.DeviceId,StringComparer.Ordinal))
        {
            var status=Statuses.GetValueOrDefault(member.DeviceId)??DeviceSnapshot.Loading(member.DeviceId);
            <li @key="member.DeviceId"><strong>@member.Label</strong><br />
                @if(status.ReportAvailability==Availability.Available&&status.ReportTime is {} instant)
                { <time datetime="@instant.ToString("O")" title="UTC: @instant.ToUniversalTime().ToString("O")">@(_times.GetValueOrDefault(member.DeviceId)??instant.ToString("u"))</time> }
                else { <span>@AvailabilityText(status.ReportAvailability,"Report time unavailable")</span> }
                @if(status.PositionAvailability!=Availability.Available){<span class="member-note">@AvailabilityText(status.PositionAvailability,"Position unavailable")</span>}
                else if(status.Latitude is {} lat && Math.Abs(lat)>85.0511287798066){<span class="member-note">Outside map projection. Reported coordinates: @status.Latitude, @status.Longitude</span>}
            </li>
        }
    </ul>
    <dl class="metadata"><dt>Source</dt><dd>@Link.SourceKind / @Link.SourceId</dd><dt>Source type</dt><dd>@Link.RawType</dd>
        @if(Link.LatestAddition is null && Link.LatestRecordedAddition is {} recorded)
        {
            <dt>Latest recorded addition</dt><dd><time datetime="@recorded.ToString("O")">@recorded.ToString("u")</time><span class="member-note">Full history not verified</span></dd>
        }
        else
        {
            <dt>Latest addition</dt><dd>@(Link.LatestAddition?.ToString("u")??"Addition time unavailable")</dd>
        }
    </dl>
    @foreach(var issue in Link.Issues){<p class="muted">@issue</p>}
</BladeContainer>
@code {
    [Parameter,EditorRequired] public LinkRecord Link {get;set;}=default!;
    [Parameter] public IReadOnlyDictionary<string,DeviceSnapshot> Statuses {get;set;}=new Dictionary<string,DeviceSnapshot>();
    [Parameter] public bool Dark {get;set;}
    [Parameter] public long Generation {get;set;}
    [Parameter] public EventCallback Close {get;set;}
    private IJSObjectReference? _module;
    private Task<IJSObjectReference>? _moduleTask;
    private readonly Dictionary<string,string> _times=new();
    private string _signature="";
    private bool _disposed;
    private static string AvailabilityText(Availability state,string missing)=>state switch{Availability.Loading=>"Loading…",Availability.Denied=>"Access denied",Availability.Failed=>"Status request failed",_=>missing};
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var signature=Link.Key+string.Join("|",Statuses.Select(s=>s.Value.ReportTime?.ToString("O")));
        if(_disposed||signature==_signature)return;_signature=signature;
        _module??=await (_moduleTask??=JS.InvokeAsync<IJSObjectReference>("import","./_content/ChefKnifeStudios.LinkedAssets.Client.Shared/js/browser-storage.js").AsTask());
        if(_disposed)return;
        var generation=Generation;var formatted=new Dictionary<string,string>();
        foreach(var status in Statuses.Values.Where(s=>s.ReportTime is not null))
        {if(_disposed||generation!=Generation)return;formatted[status.DeviceId]=await _module.InvokeAsync<string>("formatTime",status.ReportTime!.Value.ToString("O"));}
        if(!_disposed&&generation==Generation){_times.Clear();foreach(var item in formatted)_times[item.Key]=item.Value;StateHasChanged();}
    }
    public async ValueTask DisposeAsync(){_disposed=true;if(_moduleTask is not null){try{await(await _moduleTask).DisposeAsync();}catch(JSDisconnectedException){}}}
}
