@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<div class="map-frame">
    <div class="positions-map" @ref="_element" aria-label="Most recently reported member positions"></div>
    @if(!string.IsNullOrEmpty(_message)){<p class="map-message" role="status">@_message <button disabled="@_retrying" @onclick="RetryAsync">Retry map</button></p>}
</div>
@code {
    [Parameter] public DeviceSnapshot[] Statuses {get;set;}=[];
    [Parameter] public LinkMember[] Members {get;set;}=[];
    [Parameter] public bool Dark {get;set;}
    [Parameter] public long SelectionGeneration {get;set;}
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RecentPositionsMap>? _self;
    private int _instance;
    private bool _disposed,_lastDark,_updating,_renderAgain;
    private string? _message;
    private string _signature="";
    private Task? _initialization;
    private Task? _retryTask;
    private bool _retrying;
    private object Settings=>new{lightStyleUrl=Configuration["Map:LightStyleUrl"],darkStyleUrl=Configuration["Map:DarkStyleUrl"]};
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(_disposed)return;
        if(_updating){_renderAgain=true;return;}_updating=true;
        try{
            if(firstRender){_initialization=InitializeAsync();await _initialization;}
            if(_module is null||_disposed)return;
            if(_lastDark!=Dark){await _module.InvokeVoidAsync("setTheme",_instance,Dark);_lastDark=Dark;}
            var signature=SelectionGeneration+":"+string.Join("|",Statuses.Select(s=>$"{s.DeviceId}:{s.PositionAvailability}:{s.Latitude}:{s.Longitude}"));
            if(signature!=_signature){_signature=signature;await UpdateAsync();}
        }catch(JSException){_message="The map is unavailable. Report details remain available.";StateHasChanged();}
        finally{_updating=false;if(_renderAgain&&!_disposed){_renderAgain=false;await InvokeAsync(StateHasChanged);}}
    }
    private async Task InitializeAsync(){_self=DotNetObjectReference.Create(this);_module=await JS.InvokeAsync<IJSObjectReference>("import","./_content/ChefKnifeStudios.LinkedAssets.Client.Shared/js/recent-positions-map.js");if(!_disposed)await CreateAsync();}
    private async Task CreateAsync(){_instance=await _module!.InvokeAsync<int>("create",_element,_self,Settings,Dark);_lastDark=Dark;_signature="";}
    private async Task UpdateAsync()=>await _module!.InvokeVoidAsync("update",_instance,SelectionGeneration,
        Statuses.Where(s=>s.PositionAvailability==Availability.Available).Select(s=>new{deviceId=s.DeviceId,label=Members.FirstOrDefault(m=>m.DeviceId==s.DeviceId)?.Label??s.DeviceId,latitude=s.Latitude,longitude=s.Longitude}).ToArray());
    [JSInvokable] public Task MapMessage(string message,long revision){if(!_disposed&&(revision==0||revision==SelectionGeneration)){_message=message;return InvokeAsync(StateHasChanged);}return Task.CompletedTask;}
    private Task RetryAsync()=>_retrying?Task.CompletedTask:_retryTask=RetryCoreAsync();
    private async Task RetryCoreAsync(){if(_module is null||_disposed)return;_retrying=true;try{await _module.InvokeVoidAsync("dispose",_instance);if(_disposed)return;_message=null;await CreateAsync();if(!_disposed)await UpdateAsync();}finally{_retrying=false;}}
    public async ValueTask DisposeAsync(){_disposed=true;if(_initialization is not null){try{await _initialization;}catch(JSDisconnectedException){}}if(_retryTask is not null){try{await _retryTask;}catch(JSDisconnectedException){}}if(_module is not null){try{await _module.InvokeVoidAsync("dispose",_instance);await _module.DisposeAsync();}catch(JSDisconnectedException){}}_self?.Dispose();}
}
